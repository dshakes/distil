+# Directive halo — an in-band DECISION: line is pinned, but folding everything
+# around it strips the claim of the evidence it sits in: the qualifier that follows
+# a verdict ("… applies if not returned"), or the fragments that show the line was
+# spliced into the middle of another record. Isolated, the directive reads as
+# settled and the model follows it where the full context makes it verify first.
+# Keep the nearest non-blank line before and the two after. Additive (only widens
+# the keep set), so every folded line stays recoverable behind the same handle.
+# ponytail: fixed 1-before/2-after window; widen only if a trace shows a qualifier
+# further out.
+_HALO_BEFORE, _HALO_AFTER = 1, 2
+
+
+def _halo(lines: list[str], i: int) -> set[int]:
+    out: set[int] = set()
+    for step, want in ((-1, _HALO_BEFORE), (1, _HALO_AFTER)):
+        j, got = i + step, 0
+        while 0 <= j < len(lines) and got < want:
+            out.add(j)
+            got += bool(lines[j].strip())
+            j += step
+    return out
+
+
